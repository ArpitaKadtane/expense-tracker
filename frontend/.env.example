# Base URL of the Smart Expense Tracker backend API.
#
# Leave this empty during local development. The Vite dev server
# proxies requests to /api to http://localhost:8080 automatically
# (see vite.config.js), which avoids browser CORS restrictions.
#
# Set it only when the backend is served from a different origin
# that already allows CORS requests from the frontend.
VITE_API_BASE_URL=
