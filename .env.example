# Backend environment variables (see src/main/resources/application.properties).
# Copy to .env for local overrides, or set these in your hosting dashboard.

# PostgreSQL connection
DB_URL=jdbc:postgresql://localhost:5432/expense_tracker
DB_USER=expense
DB_PASSWORD=expense

# HTTP port
PORT=8080

# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=*

# JWT signing secret — MUST be at least 32 characters.
# Generate a strong value for production, e.g.:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-characters

# JWT token lifetime in milliseconds (default: 24 hours)
JWT_EXPIRATION_MS=86400000
